    "file_header_lines_seen": [
      "Weights: Population"
    ],
    "explanation_page_sentence": "State, Regional, and National Data Degree days are estimated for State climate divisions and then population weighted to more accurately reflect temperature-related energy consumption at the State, regional, and national levels. (https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/cdus/degree_days/ddayexp.shtml; this page is older and cites 2000 Census weights)",
    "nclimdiv_readme_methodology_sentence_verbatim": "Statewide, regional and national values in nClimDiv were derived from area-weighted averages of 5km X 5km grid-point estimates interpolated from station data. (https://www.ncei.noaa.gov/pub/data/cirs/climdiv/state-readme.txt)",
    "nclimdiv_readme_degree_day_sentence_verbatim": "Population weights utilize the 2010 Census data."
  },
