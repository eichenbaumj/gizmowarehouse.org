  "population_weighting": {
    "noaa_sentence_verbatim": "These data include population weighted State, Census Divisional and National data using 2010 Census data (excluding Alaska and Hawaii), and heating fuel weighted Census Divisional and National data using the 2010 Annual Community Survey data.",
